# See https://help.github.com/articles/ignoring-files/

# --- Dependencies ---
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- Next.js / build output ---
/.next/
/out/
/build
/dist

# --- TypeScript ---
*.tsbuildinfo
next-env.d.ts

# --- Testing (Vitest) ---
/coverage
*.lcov

# --- E2E (Playwright) ---
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# --- Environment & secrets (never commit API keys) ---
.env
.env.*
!.env.example
.envrc
*.pem
*.key
*.p12
*.pfx
secrets/
.credentials

# --- OpenRouter / AI (local dumps, exports) ---
.openrouter/
*.openrouter-cache
ai-debug/
prompt-dumps/
*.prompt.log

# --- Observability (local Sentry / OTel) ---
.sentryclirc
.sentry-native/
*.sentry-build-plugin

# --- Vercel / hosting ---
.vercel
.vercel.output

# --- Turbo / tooling caches ---
.turbo
.eslintcache
.stylelintcache
.cache
.parcel-cache

# --- Logs & debug ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
lerna-debug.log*
*.log
logs/

# --- OS ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# --- Editors / IDE (optional local settings) ---
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# --- Cursor (local agent state; keep shared rules if you commit them) ---
.cursor/projects/
.cursor/terminals/

# --- Misc ---
*.local.md
*.orig
