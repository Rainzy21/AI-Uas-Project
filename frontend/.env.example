# --- Recommended: free Kimi (vision) via OpenRouter ---
# Get a free key at https://openrouter.ai/keys (no credits needed for :free models)
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=moonshotai/kimi-k2.6:free
ANALYZE_PROVIDER=openrouter

# If Kimi is rate-limited, the app auto-tries openrouter/free, then Gemini/DeepSeek if set.
# GEMINI_API_KEY=your_gemini_key_here
# GEMINI_MODEL=gemini-2.5-flash
# DEEPSEEK_API_KEY=your_deepseek_key_here
# DEEPSEEK_MODEL=deepseek-chat

# Auto-fallback to another provider on 429 (default: enabled)
# ANALYZE_FALLBACK=false

# Public app URL for OpenRouter referer header
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: protect /api/analyze in production (set same value on client)
# ANALYZE_API_SECRET=your_random_secret_here
# NEXT_PUBLIC_ANALYZE_API_SECRET=your_random_secret_here

# Per-IP rate limit (proxy on /api/analyze) — disabled in `npm run dev` by default
# RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW_SEC=60

# Timeouts (ms) — dev defaults are longer for slow free models
# OPENROUTER_TIMEOUT_MS=90000
# NEXT_PUBLIC_ANALYZE_TIMEOUT_MS=120000
# Production: create a free Redis at https://upstash.com and set:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Error tracking (https://sentry.io)
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# OpenTelemetry via Vercel OTel (enable on Vercel or local experiments)
# OTEL_ENABLED=true
